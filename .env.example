# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# OpenAI (primary) or Anthropic (set LLM_PROVIDER=anthropic)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=
LLM_PROVIDER=openai

# Resend
RESEND_API_KEY=re_...
EMAIL_FROM=SubCertify <alerts@yourdomain.com>

# Lemon Squeezy — $99/mo subscription variant with a 14-day trial
# STORE_ID is numeric (Settings → Stores), not the store slug
LEMONSQUEEZY_API_KEY=ey...
LEMONSQUEEZY_STORE_ID=12345
LEMONSQUEEZY_VARIANT_ID=12345
LEMONSQUEEZY_WEBHOOK_SECRET=your_webhook_signing_secret

# Comma-separated emails that skip Lemon Squeezy (unlimited complimentary access)
COMPLIMENTARY_EMAILS=rohitkota4@gmail.com

# Daily cron — Vercel sends Authorization: Bearer <CRON_SECRET>
CRON_SECRET=generate_a_long_random_string
